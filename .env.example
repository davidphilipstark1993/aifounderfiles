# Local-only switch for the Astro dev server.
# Set to "false" to hide draft files and preview the production empty states.
# PUBLIC_SHOW_DRAFTS=false

# ---- Newsletter ----
# Used by api/*.ts (Vercel Functions) and scripts/newsletter/weekly-send.ts (GitHub Action).
# Set these in Vercel: Settings > Environment Variables.
# The weekly send also needs SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SENDGRID_API_KEY,
# SENDGRID_FROM_EMAIL, SENDGRID_FROM_NAME, SENDGRID_UNSUBSCRIBE_GROUP_ID and ADMIN_EMAILS
# as GitHub repository secrets. Never commit real values.

SITE_URL=https://aifounderfiles.com

# Supabase project dedicated to AI Founder Files.
# Run supabase/migrations/001_newsletter.sql in its SQL editor. Keep the service-role key secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SendGrid. The API key needs Mail Send and Marketing permissions.
SENDGRID_API_KEY=
# Must be a verified sender or an address on an authenticated domain.
SENDGRID_FROM_EMAIL=info@aifounderfiles.com
SENDGRID_FROM_NAME=AI Founder Files
# Marketing contact list that holds AI Founder Files subscribers.
SENDGRID_LIST_ID=
# Unsubscribe group (ASM) used for one-click unsubscribe in every email.
SENDGRID_UNSUBSCRIBE_GROUP_ID=
# Public key shown when you enable "Signed Event Webhook" in SendGrid.
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Who receives the sent / not sent / failed alerts (comma-separated).
ADMIN_EMAILS=
