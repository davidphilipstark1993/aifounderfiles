---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FactBox from '../../components/FactBox.astro';
import FileCard from '../../components/FileCard.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import {
  factFields,
  fileNumberLabel,
  fileUrl,
  formatDate,
  getPublishedFiles,
  isoDate,
  isUpcoming,
  notAfterNow,
  readingTime,
  relatedFiles,
  type FileEntry,
} from '../../lib/files';
import { authorAbsoluteUrl, authorUrl, getFileAuthor } from '../../lib/authors';
import { authorLd, breadcrumbLd, companyLd, founderLds, publisherLd } from '../../lib/schema';
import { citationCounts, citeAnchor, sourceAnchor, stripCitations, textWithCitations } from '../../lib/citations';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const files = await getPublishedFiles();
  return files.map((entry) => ({ params: { slug: entry.id }, props: { entry, files } }));
}

interface Props {
  entry: FileEntry;
  files: FileEntry[];
}
const { entry, files } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const author = await getFileAuthor(entry);

const minutes = readingTime(entry.body);
const cited = citationCounts(entry.body);
const upcoming = isUpcoming(entry);
const related = relatedFiles(entry, files, 3);
const ogPath = `/og/${entry.id}.png`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: data.title,
  description: data.description ?? data.standfirst,
  image: [new URL(ogPath, SITE.url).href],
  datePublished: notAfterNow(data.publishDate).toISOString(),
  dateModified: notAfterNow(data.updatedDate ?? data.publishDate).toISOString(),
  author: authorLd(author),
  publisher: publisherLd,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  about: [...founderLds(data), companyLd(data)],
  keywords: data.tags.join(', '),
  articleSection: data.company.sector,
  inLanguage: 'en-GB',
  isAccessibleForFree: true,
  citation: data.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Archive', path: '/archive/' },
  { name: data.title, path: fileUrl(entry) },
];

const faq = data.faq ?? [];
const faqLd = faq.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: stripCitations(q.answer) },
  })),
};
const jsonLd = [articleLd, breadcrumbLd(crumbs), ...(faqLd ? [faqLd] : [])];
---
<BaseLayout
  title={data.title}
  description={data.description ?? data.standfirst}
  type="article"
  image={ogPath}
  imageAlt={`${data.title} — Founder File ${fileNumberLabel(data.fileNumber)}`}
  noindex={data.draft}
  jsonLd={jsonLd}
  article={{ published: notAfterNow(data.publishDate), modified: data.updatedDate && notAfterNow(data.updatedDate), author: authorAbsoluteUrl(author), section: data.company.sector, tags: data.tags }}
>
  {data.draft && (
    <div class="draft-banner">
      <p class="label">Draft · visible in dev only · excluded from production builds</p>
    </div>
  )}

  {upcoming && (
    <div class="early-banner on-manila">
      <div class="wrap early-banner__inner">
        <p class="label"><strong>Early read.</strong> This file goes out to subscribers on {formatDate(data.publishDate)}.</p>
        <a class="early-banner__link label" href="/subscribe/">Get it in your inbox</a>
      </div>
    </div>
  )}

  <article>
    <header class="file-head">
      <div class="wrap file-head__grid">
        <div>
          <nav class="crumbs label label--muted" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true"> / </span><a href="/archive/">Archive</a><span aria-hidden="true"> / </span><span aria-current="page">File {fileNumberLabel(data.fileNumber)}</span>
          </nav>
          <p class="label label--signal">Founder File {fileNumberLabel(data.fileNumber)}</p>
          <h1 class="display file-title">{data.title}</h1>
          <p class="file-standfirst">{data.standfirst}</p>
          <p class="byline label label--muted">
            <span>By <a href={authorUrl(author)} rel="author">{author.data.name}</a></span>
            <span aria-hidden="true">·</span>
            <span>Published <time datetime={isoDate(data.publishDate)}>{formatDate(data.publishDate)}</time></span>
            {data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time></span>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </p>
        </div>
        <div class="file-head__fact">
          <FactBox id="file-fact" fields={factFields(data)} />
        </div>
      </div>
    </header>

    {data.heroImage && (
      <figure class="wrap file-hero">
        <Image src={data.heroImage.src} alt={data.heroImage.alt} widths={[640, 960, 1200]} sizes="(min-width: 1232px) 1200px, 100vw" loading="eager" fetchpriority="high" />
      </figure>
    )}

    <div class="file-body">
      <div class="wrap">
        <div class="prose file-prose">
          <Content />
        </div>

        {faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title" class="label">Quick answers</h2>
            {faq.map((q, i) => (
              <div class="faq__item">
                <h3>{q.question}</h3>
                <p set:html={textWithCitations(q.answer, data.sources.length, `faq${i + 1}`)} />
              </div>
            ))}
          </section>
        )}

        <section class="sources" aria-labelledby="sources-title">
          <h2 id="sources-title" class="label">Sources</h2>
          <ol>
            {data.sources.map((s, i) => (
              <li id={sourceAnchor(i + 1)}>
                <a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}<span class="visually-hidden"> (opens in a new tab)</span></a>
                <span class="sources__host label label--muted">
                  {hostOf(s.url)}
                  {(cited.get(i + 1) ?? 0) > 0 && (
                    <span class="sources__back">
                      {Array.from({ length: cited.get(i + 1)! }, (_, k) => (
                        <a href={`#${citeAnchor(i + 1, k + 1)}`}>
                          <span aria-hidden="true">↩{cited.get(i + 1)! > 1 ? k + 1 : ''}</span>
                          <span class="visually-hidden">Back to where source {i + 1} is cited{cited.get(i + 1)! > 1 ? ` (${k + 1} of ${cited.get(i + 1)})` : ''}</span>
                        </a>
                      ))}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </div>
  </article>

  <NewsletterBand id="file-subscribe" heading="Get next week’s file" text="One founder, one company, one deep dive, in your inbox every week." />

  {related.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="wrap">
        <div class="section-head"><h2 id="related-title">Related files</h2></div>
        <ul class="related" role="list">
          {related.map((r) => <li><FileCard entry={r} /></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .early-banner {
    background: var(--manila);
    padding-block: 0.65rem;
  }
  .early-banner__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    text-align: center;
  }
  .early-banner__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .file-head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
  }
  .file-head__grid {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  .file-title {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 7.4vw, 4.5rem);
  }
  .file-standfirst {
    margin-top: 1.4rem;
    max-width: 46ch;
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--slate);
  }
  .crumbs {
    margin-bottom: 1.25rem;
    font-size: 0.75rem;
  }
  .crumbs a {
    color: inherit;
  }
  .byline a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.65rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    max-width: 56ch;
  }
  .file-head__fact {
    max-width: 28rem;
  }
  @media (min-width: 900px) {
    .file-head__grid {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
    .file-head__fact {
      margin-top: 0.4rem;
    }
  }
  @media (min-width: 1100px) {
    .file-head__grid {
      grid-template-columns: minmax(0, 1fr) 25rem;
    }
  }
  .file-hero {
    margin-bottom: 2.5rem;
  }
  .file-hero :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .file-body {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .file-prose,
  .faq,
  .sources {
    margin-inline: auto;
  }
  .faq {
    max-width: var(--measure);
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .faq__item {
    margin-top: 1.5rem;
  }
  .faq h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 90%;
    font-size: 1.1875rem;
    line-height: 1.2;
  }
  .faq p {
    margin-top: 0.4rem;
    line-height: 1.55;
  }
  .sources {
    max-width: var(--measure);
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .sources ol {
    margin: 1rem 0 0;
    padding-left: 1.6em;
    font-size: 1rem;
    line-height: 1.45;
  }
  .sources li {
    padding-block: 0.4rem;
    padding-left: 0.4rem;
  }
  .sources li::marker {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--graphite);
  }
  .sources a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .sources a:hover {
    color: var(--signal);
  }
  .sources__host {
    display: block;
    font-size: 0.75rem;
    margin-top: 0.15rem;
  }
  .sources__back {
    margin-left: 0.75rem;
  }
  .sources__back a {
    display: inline-block;
    min-width: 1.5rem;
    text-align: center;
    text-decoration: none;
    color: var(--signal);
  }
  .related {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
