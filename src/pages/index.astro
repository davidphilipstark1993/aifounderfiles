---
import BaseLayout from '../layouts/BaseLayout.astro';
import FactBox from '../components/FactBox.astro';
import FileCard from '../components/FileCard.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import SampleIssue from '../components/SampleIssue.astro';
import Arrow from '../components/Arrow.astro';
import { factFields, fileNumberLabel, fileUrl, getPublishedFiles, isUpcoming } from '../lib/files';
import { SITE } from '../lib/site';
import { currentIssue } from '../data/current-issue';

const files = await getPublishedFiles();
// This week's file is the newest one that has already gone out. Files dated in the future are
// "early reads" and are listed under "Coming up" until their Sunday.
const issued = files.filter((f) => !isUpcoming(f));
const latest = issued.find((f) => !f.data.draft) ?? issued[0] ?? files.at(-1);
const comingUp = files.filter((f) => isUpcoming(f) && f.id !== latest?.id).reverse(); // soonest first
const previous = issued.filter((f) => f.id !== latest?.id).slice(0, 6);

const published = latest?.data.publishDate ?? currentIssue.publishDate;
const issueNumber = latest?.data.fileNumber ?? currentIssue.fileNumber;
const daysOld = (Date.now() - published.getTime()) / 86_400_000;
const eyebrow = `Founder File ${fileNumberLabel(issueNumber)} · ${daysOld <= 8 ? 'This week' : 'Latest file'}${latest?.data.draft ? ' · Draft' : ''}`;
const title = latest?.data.title ?? currentIssue.title;
const standfirst = latest?.data.standfirst ?? currentIssue.standfirst;
const facts = latest ? factFields(latest.data, true) : currentIssue.facts;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'en-GB',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];
---
<BaseLayout
  fullTitle
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <h1 class="visually-hidden">{SITE.name}: {SITE.tagline}</h1>

  <section id="latest" class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="label label--signal">{eyebrow}</p>
        <h2 id="hero-title" class="display hero__title">{title}</h2>
        <p class="hero__standfirst">{standfirst}</p>
        {latest ? (
          <a class="link-arrow" href={fileUrl(latest)}>
            <span>Read the file<span class="visually-hidden">: {title}</span></span><Arrow />
          </a>
        ) : (
          <a class="link-arrow" href="/subscribe/"><span>Get the file in your inbox<span class="visually-hidden">: {title}</span></span><Arrow /></a>
        )}
      </div>
      <div class="hero__fact">
        <FactBox id="hero-fact" fields={facts} />
      </div>
    </div>
  </section>

  {comingUp.length > 0 && (
    <section class="section section--rule" aria-labelledby="coming-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="coming-title">Coming up</h2>
          <a class="link-arrow" href="/archive/"><span>All files</span><Arrow /></a>
        </div>
        <p class="coming-note">Early reads. Each goes out to subscribers on the date shown. Read them now, or <a href="/subscribe/">subscribe</a> to get each one in your inbox on the day.</p>
        <ul class="grid" role="list">
          {comingUp.map((entry) => (
            <li><FileCard entry={entry} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {previous.length > 0 && (
    <section class="section section--rule" aria-labelledby="previous-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="previous-title">Previous files</h2>
          <a class="link-arrow" href="/archive/"><span>All files</span><Arrow /></a>
        </div>
        <ul class="grid" role="list">
          {previous.map((entry) => (
            <li><FileCard entry={entry} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="section--rule"><SampleIssue id="home-sample" /></div>

  <NewsletterBand id="home-subscribe" />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5rem);
  }
  .hero__grid {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  .hero__title {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 7.5vw, 4.75rem);
  }
  .hero__standfirst {
    margin-top: 1.5rem;
    max-width: 44ch;
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--slate);
  }
  .hero__copy .link-arrow {
    margin-top: 1rem;
  }
  .hero__fact {
    max-width: 28rem;
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
    .hero__fact {
      margin-top: 0.4rem;
    }
  }
  @media (min-width: 1100px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) 25rem;
    }
  }
  .coming-note {
    margin: -0.5rem 0 1.5rem;
    max-width: 60ch;
    font-size: 1rem;
    color: var(--slate);
  }
  .coming-note a {
    color: var(--ink);
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
