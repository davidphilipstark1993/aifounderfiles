---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title="File not found" description="We couldn’t find that page." noindex>
  <section class="nf">
    <div class="wrap nf__grid">
      <div>
        <p class="label label--signal">Error 404</p>
        <h1 class="display nf__title">File not found.</h1>
        <p class="nf__text">The page you’re looking for has been moved, renamed or never existed. Try the archive, or head back to this week’s file.</p>
        <div class="nf__links">
          <a class="btn" href="/">Back to home</a>
          <a class="link-arrow" href="/archive/"><span>Browse the archive</span><Arrow /></a>
        </div>
      </div>
      <p class="nf__stamp label" aria-hidden="true">Not on file</p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(3rem, 9vw, 7rem);
  }
  .nf__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .nf__title {
    margin-top: 1rem;
    font-size: clamp(3rem, 11vw, 7rem);
  }
  .nf__text {
    margin-top: 1.25rem;
    max-width: 40ch;
    color: var(--slate);
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }
  .nf__stamp {
    justify-self: start;
    transform: rotate(-5deg);
    border: 4px solid var(--signal);
    color: var(--signal);
    font-weight: 700;
    font-size: clamp(1.125rem, 3vw, 1.75rem);
    letter-spacing: 0.2em;
    padding: 0.6rem 1.4rem;
  }
  @media (min-width: 900px) {
    .nf__grid {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .nf__stamp {
      justify-self: end;
      margin-right: 3rem;
    }
  }
</style>
