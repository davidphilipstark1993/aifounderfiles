---
/**
 * Newsletter signup. Posts to /api/subscribe (a Vercel Function, see api/subscribe.ts), which saves the
 * subscriber, syncs SendGrid and sends the welcome email. Without JS the form posts normally and the
 * function redirects to /subscribed/; with JS it validates first and shows inline success/error states.
 */
interface Props {
  id: string; // unique per instance on a page
  theme?: 'light' | 'dark';
  buttonLabel?: string;
  source?: string; // recorded with the subscriber, e.g. "home", "article"
}
const { id, theme = 'light', buttonLabel = 'Subscribe', source = id } = Astro.props;
---
<form
  class:list={['subscribe', { 'on-ink': theme === 'dark' }]}
  method="post"
  action="/api/subscribe"
  novalidate
  data-subscribe
>
  <input type="hidden" name="source" value={source} />
  <label class="label subscribe__label" for={`${id}-email`}>Email address</label>
  <div class="subscribe__row">
    <input
      class="subscribe__input"
      id={`${id}-email`}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      autocapitalize="off"
      spellcheck="false"
      required
      placeholder="you@company.com"
      aria-describedby={`${id}-hint ${id}-msg`}
    />
    <button class="btn" type="submit">{buttonLabel}</button>
  </div>

  <div class="subscribe__consent">
    <input type="checkbox" id={`${id}-consent`} name="consent" required />
    <label for={`${id}-consent`}>
      I’d like to receive the weekly AI Founder Files email. I can unsubscribe at any time. See the{' '}
      <a href="/privacy/">privacy policy</a>.
    </label>
  </div>

  <!-- Honeypot: real visitors never see or fill this. -->
  <div class="subscribe__trap" aria-hidden="true">
    <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <p class="subscribe__hint" id={`${id}-hint`}>One email a week, on Sundays.</p>
  <p class="subscribe__msg" id={`${id}-msg`} aria-live="polite" aria-atomic="true" data-msg></p>
</form>

<style>
  .subscribe {
    width: 100%;
    max-width: 34rem;
  }
  .subscribe__label {
    display: block;
    margin-bottom: 0.5rem;
  }
  .subscribe__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .subscribe__input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1rem;
    background: var(--white);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1.0625rem; /* ≥16px stops iOS zooming on focus */
  }
  .subscribe__input::placeholder {
    color: var(--graphite);
    opacity: 1;
  }
  .subscribe__input[aria-invalid='true'] {
    border-color: var(--signal);
  }
  .subscribe__input:focus-visible {
    outline-offset: 2px;
  }
  .subscribe .btn {
    flex: 0 0 auto;
    min-height: 3rem;
  }
  .subscribe__hint {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--graphite);
  }
  .on-ink .subscribe__hint {
    color: var(--ink-muted);
  }
  .on-ink .subscribe__input[aria-invalid='true'] {
    border-color: var(--signal-light);
  }
  .subscribe__msg {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.4;
  }
  .subscribe__msg:empty {
    display: none;
  }
  .subscribe__msg[data-kind] {
    padding: 0.6rem 0.9rem;
    border-left: 4px solid currentColor;
    background: var(--white);
    font-weight: 600;
  }
  .subscribe__msg[data-kind='error'] {
    color: var(--signal);
  }
  .subscribe__msg[data-kind='success'] {
    color: var(--ink);
    border-left-color: var(--slate);
  }
  .on-ink .subscribe__msg[data-kind] {
    background: transparent;
    border-left-width: 4px;
  }
  .on-ink .subscribe__msg[data-kind='error'] {
    color: var(--signal-light);
  }
  .on-ink .subscribe__msg[data-kind='success'] {
    color: var(--paper);
    border-left-color: var(--paper);
  }
  .subscribe__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .subscribe__consent input {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    margin: 0.1rem 0 0;
    accent-color: var(--signal);
    cursor: pointer;
  }
  .subscribe__consent label {
    padding-block: 0.1rem;
    cursor: pointer;
  }
  .subscribe__consent a {
    color: inherit;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .on-ink .subscribe__consent input {
    accent-color: var(--signal-light);
  }
  .subscribe__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const consent = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;

    const show = (kind: 'error' | 'success', text: string) => {
      msg.dataset.kind = kind;
      msg.textContent = text;
    };
    const clear = () => {
      delete msg.dataset.kind;
      msg.textContent = '';
      input.removeAttribute('aria-invalid');
      consent.removeAttribute('aria-invalid');
    };
    const invalid = (field: HTMLInputElement, text: string) => {
      field.setAttribute('aria-invalid', 'true');
      show('error', text);
      field.focus();
    };

    input.addEventListener('input', () => {
      if (input.getAttribute('aria-invalid') === 'true' && EMAIL.test(input.value.trim())) clear();
    });
    consent.addEventListener('change', () => {
      if (consent.checked && consent.getAttribute('aria-invalid') === 'true') clear();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();

      if (!email) return invalid(input, 'Enter your email address.');
      if (!EMAIL.test(email)) return invalid(input, 'That doesn’t look like an email address. Check it and try again.');
      if (!consent.checked) return invalid(consent, 'Please tick the box to confirm you’d like to receive the newsletter.');
      clear();

      button.disabled = true;
      try {
        const res = await fetch(form.getAttribute('action') || '/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            consent: true,
            source: (form.elements.namedItem('source') as HTMLInputElement | null)?.value,
            website: (form.elements.namedItem('website') as HTMLInputElement | null)?.value,
          }),
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data?.ok) {
          show('success', 'Thanks, you’re on the list. A welcome email is on its way.');
          form.reset();
        } else if (res.status === 400 && data?.error) {
          invalid(input, data.error);
        } else if (res.status === 503 || res.status === 404) {
          show('error', 'Signup isn’t available just yet. Please check back soon.');
        } else {
          show('error', 'Something went wrong. Please try again in a moment.');
        }
      } catch {
        show('error', 'We couldn’t reach the server. Check your connection and try again.');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
