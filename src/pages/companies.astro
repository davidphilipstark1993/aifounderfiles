---
import PageLayout from '../layouts/PageLayout.astro';
import Arrow from '../components/Arrow.astro';
import { SITE } from '../lib/site';
import { fileNumberLabel, fileUrl, formatDate, getCompanies, isoDate, shortVersion } from '../lib/files';
const companies = await getCompanies();
const url = `${SITE.url}/companies/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Companies',
    url,
    description: 'Every AI company profiled in an AI Founder Files deep dive, with its sector, stage, founder and a link to the full, sourced file. A new company every week.',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: companies.length,
      itemListElement: companies.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(fileUrl(c.entry), SITE.url).href,
        name: c.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Companies', item: url },
    ],
  },
];
const detail = (c: (typeof companies)[number]) =>
  [c.sector, c.stage, c.hq].filter((v) => v && !/^undisclosed$/i.test(v)).join(' · ');
---
<PageLayout
  noindex={companies.length === 0}
  title="Companies: Every AI Company We’ve Profiled"
  description="Every AI company profiled in an AI Founder Files deep dive, with its sector, stage, founder and a link to the full, sourced file. A new company every week."
  label="The index"
  heading="Companies"
  lede="Every company we’ve profiled, with a link to its file."
  prose={false}
  jsonLd={jsonLd}
>
  {companies.length > 0 ? (
    <>
    <p class="hub-intro">{companies.length} {companies.length === 1 ? 'company' : 'companies'} profiled so far. Each entry links to the full, sourced file. See also <a href="/founders/">the founders</a> and <a href="/archive/">the archive</a>. A short guide to <a href="/how-ai-companies-make-money/">how these companies make money</a> and a list of the <a href="/sourced-profiles/">sourced profiles</a> are also available.</p>
    <h2 class="index__year">Companies profiled</h2>
    <ul class="index" role="list">
      {companies.map((c) => (
        <li>
          <a class="index__row" href={fileUrl(c.entry)}>
            <span class="index__num label label--muted">{fileNumberLabel(c.entry.data.fileNumber)}</span>
            <span class="index__main">
              <span class="index__title">{c.name}</span>
              <span class="index__sub">{detail(c)}</span>
              {shortVersion(c.entry).what && <span class="index__sub">{shortVersion(c.entry).what}</span>}
            </span>
            <span class="index__meta label label--muted">Founder: {c.founder} · <time datetime={isoDate(c.entry.data.publishDate)}>{formatDate(c.entry.data.publishDate, 'short')}</time></span>
            <span class="index__go" aria-hidden="true"><Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
    </>
  ) : (
    <div class="empty-state">
      <p class="label label--signal">Nothing filed yet</p>
      <p><strong>No companies yet.</strong> The first company is announced with file #001. Each one we cover will be listed here.</p>
      <a class="link-arrow" href="/subscribe/"><span>Subscribe to hear first</span><Arrow /></a>
    </div>
  )}
</PageLayout>
