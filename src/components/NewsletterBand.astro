---
import SubscribeForm from './SubscribeForm.astro';
interface Props {
  id: string;
  heading?: string;
  text?: string;
}
const {
  id,
  heading = 'One founder. One company. One deep dive.',
  text = 'Every week we open one file: the founder, the product, the funding and the business model behind a new AI company, told in full. Get it in your inbox.',
} = Astro.props;
---
<section class="band on-ink" aria-labelledby={`${id}-title`}>
  <div class="wrap band__grid">
    <div class="band__copy">
      <p class="label label--signal">The weekly file</p>
      <h2 id={`${id}-title`} class="display band__title">{heading}</h2>
      <p class="band__text">{text}</p>
    </div>
    <div class="band__form">
      <SubscribeForm id={id} theme="dark" />
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .band__grid {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }
  .band__title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    max-width: 14ch;
  }
  .band__text {
    margin-top: 1.1rem;
    max-width: 44ch;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }
  @media (min-width: 900px) {
    .band__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>
