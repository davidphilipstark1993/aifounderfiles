---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';

import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../lib/site';

interface Props {
  /** Page title. " | AI Founder Files" is appended unless `fullTitle` is set. */
  title: string;
  fullTitle?: boolean;
  description: string;
  /** Absolute or site-relative path to a 1200×630 image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Show the site-wide advert strip above the footer. Pages with their own ad placement pass false. */
  adSlot?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  article?: { published: Date; modified?: Date; author: string; section?: string; tags?: string[] };
}

const {
  title,
  fullTitle = false,
  description,
  image = '/og-default.png',
  imageAlt = `${SITE.name} — ${SITE.tagline}`,
  type = 'website',
  noindex = false,
  adSlot = true,
  jsonLd,
  article,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1Z82S4LNVM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1Z82S4LNVM');
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F7F5F0" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — new files`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={serifLatin} crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        <meta property="article:author" content={article.author} />
        {article.section && <meta property="article:section" content={article.section} />}
        {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {ld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {adSlot && <AdSlot placement="sitewide" tone="rule" />}
    <Footer />
  </body>
</html>
